{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "airmeishi-backend",
	"main": "src/index.ts",
	"account_id": "8ed27adf5fb9847bb469619634095076",
	"compatibility_date": "2025-09-13",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Retired 2026-11-04: only the account-deletion stub in `src/index.ts` is
	// left, on its workers.dev hostname, because app 2.0.0 calls it there. No
	// D1, no secrets, no cron, no custom domain. The creds.id services deploy
	// from `wrangler.nip05.jsonc` into the account that owns the zone
	// (`bun run deploy:nip05`).
	"workers_dev": true,
	// An empty list removes the old hourly inbox-cleanup trigger on deploy.
	"triggers": {
		"crons": []
	}
}
